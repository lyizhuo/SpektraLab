<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the user's photographs and writing exports: both through the
         system pickers (SAF) and MediaStore, so no storage permission is
         needed on API 29+. A long export runs as a data-sync foreground
         worker, which is why the notification permission is asked for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- C3: `RAW_SENSOR` needs no permission of its own beyond CAMERA. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The camera is optional, not required: the editor and the importer are
         the product, and a tablet with no rear camera must still install.
         `any` rather than `back` because a device may expose only the front
         one; the C3 lens bar reports what it finds and says so when it is
         empty. RAW is a capability, not a hardware feature, so it cannot be
         declared here — CameraInventory probes it at run time. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SpektraLabApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpektraLab">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.SpektraLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- C3. Locked to portrait while shooting: the capture session's
             surfaces are tied to the display rotation at configure time, and a
             rotate mid-capture drops the frame. The editor rotates freely. -->
        <activity
            android:name=".CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SpektraLab" />

        <!-- One DNG per capture, handed to the editor by content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager runs a long export through its own foreground service;
             the type has to be declared here, and `dataSync` is the one an
             export belongs to (it moves the user's own data out of the app).
             Without this the notification is refused on API 34+ — which is
             what the release lint flagged. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
